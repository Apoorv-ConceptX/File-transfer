{
  "name": "relay-file-toolkit",
  "version": "1.0.0",
  "description": "Vercel-ready Google Drive copying, metadata and inventory toolkit",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "inngest": "^4.26.1",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "inngest": {
      "zod": "$zod"
    }
  }
}
